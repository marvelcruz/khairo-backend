# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/khairo?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_this_with_a_long_random_string_before_deploying
JWT_EXPIRES_IN=8h
COOKIE_EXPIRES_DAYS=1

# CORS - your deployed frontend URL(s), comma separated
CLIENT_URL=http://localhost:3007

# One-click Connections
# Configure provider applications once at platform level. Customers only sign in.
# In production set this to: https://<backend-host>/api/social/connections/callback
OAUTH_CALLBACK_BASE_URL=http://localhost:5000/api/social/connections/callback
INTEGRATION_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret

# Google / Gmail / Google Business Profile
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_oauth_client_secret

# Meta / Instagram / Facebook / WhatsApp
META_APP_ID=replace_with_meta_app_id
META_APP_SECRET=replace_with_meta_app_secret
META_REDIRECT_URI=replace_with_meta_oauth_redirect_uri
META_WEBHOOK_VERIFY_TOKEN=replace_with_a_long_random_webhook_verify_token

# LinkedIn
LINKEDIN_CLIENT_ID=replace_with_linkedin_client_id
LINKEDIN_CLIENT_SECRET=replace_with_linkedin_client_secret

# TikTok
TIKTOK_CLIENT_KEY=replace_with_tiktok_client_key
TIKTOK_CLIENT_SECRET=replace_with_tiktok_client_secret

# Existing WhatsApp Business runtime credentials
WHATSAPP_TOKEN=replace_with_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_with_whatsapp_business_account_id
WHATSAPP_GRAPH_API_VERSION=v25.0

# Initial admin seed (used only by npm run seed:admin, then remove/change)
SEED_ADMIN_EMAIL=admin@khairo.example.com
SEED_ADMIN_PASSWORD=change_me_immediately
SEED_ADMIN_NAME=Admin

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Apple Sign In
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
BACKEND_URL=
